{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "lib": [
            "ES2022", "DOM"
        ],
        "declaration": true,
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "outDir": "dist",
        "rootDir": ".",
        "types": ["node"]
    },
    "include": [
        "src",
        "tests",
        "examples"
    ],
    "exclude": [
        "dist",
        "node_modules"
    ]
}